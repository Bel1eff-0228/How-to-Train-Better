# OpenAI-compatible chat/completions endpoint; server only
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
# Generate a random secret of at least 32 characters. Never expose to client.
PLAN_SIGNING_SECRET=
MODEL_DAILY_CALL_LIMIT=20
# Only true for a single persistent Node process. Multi-instance requires shared limits.
AGENT_SINGLE_INSTANCE=true
# DeepSeek defaults to disabled thinking for compact structured output.
MODEL_THINKING=disabled
MODEL_TIMEOUT_MS=60000
# Logs only timing/status/error categories; no prompts or model answers.
MODEL_DIAGNOSTICS=false

# Required in production: random ASCII password, at least 20 characters. Username: tester.
TEST_ACCESS_PASSWORD=

# Temporarily log authentication reason codes only; turn off after diagnosis.
AUTH_DIAGNOSTICS=false
